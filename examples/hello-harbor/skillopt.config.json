{
  "name": "hello-harbor: optimize format-answer",
  "skillUnderTest": "./skills/format-answer/SKILL.md",
  "taskPack": "./tasks",
  "rollout": {
    "backend": "docker",
    "agent": "claude-code",
    "model": "anthropic/claude-opus-4-8",
    "setup": {
      "env": ["ANTHROPIC_API_KEY"]
    }
  },
  "splits": {
    "train": ["capital-france", "ceo-acme", "founded-globex"],
    "selection": ["capital-japan", "mascot-pip"],
    "test": ["capital-spain"]
  },
  "editBudget": 3,
  "minEditBudget": 1,
  "lrSchedule": "cosine",
  "gateMetric": "mixed",
  "mixedWeight": 0.5,
  "selectionSamples": 3,
  "maxSteps": 20
}
