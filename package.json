{
  "name": "pi-skillopt",
  "version": "0.1.0",
  "type": "module",
  "description": "Autonomous SkillOpt loop for pi: an extension that optimizes a SKILL.md against Harbor rollouts, keeping only edits that beat a held-out score.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "skillopt",
    "skill",
    "optimization",
    "harbor",
    "evals",
    "coding-agent"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "extensions",
    "skills",
    "examples",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "devDependencies": {
    "@mariozechner/pi-ai": "^0.65.0",
    "@mariozechner/pi-coding-agent": "^0.65.0",
    "@mariozechner/pi-tui": "^0.65.0",
    "@sinclair/typebox": "^0.34.41",
    "typescript": "^5.6.0"
  }
}
